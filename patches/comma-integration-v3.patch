+def v3_enabled():
+  value = os.environ.get('CARROT_JETLINK_V3', '0')
+  if value not in ('0', '1'):
+    raise ValueError('CARROT_JETLINK_V3 must be 0 or 1')
+  return value == '1'
+
+
+def jetson_spec(peer, mode='usb'):
+  """Only the explicit USB/TRT selection may use the protocol2 exception."""
+  enabled = v3_enabled()
+  if not isinstance(peer, dict) or peer.get('backend') != 'trt' or mode != 'usb':
+    return None
+  if not enabled:
+    return DEFAULT_SPEC
+  from jetlink.v3_compat import CAPABILITY, validate_capability
+  if type(peer.get('protocol')) is not int or peer['protocol'] != 2:
+    raise ValueError('Cinque v3 requires the patched Jetson protocol2 capability')
+  validate_capability(peer.get(CAPABILITY))
+  return V3_SPEC
+
+
+def validate_selected_spec(spec, peer=None, mode='usb'):
+  validate_model_spec(spec)
+  # Older local App handshakes carry only a generic spec. Retain that wire
+  # compatibility, but never let it authorize the newly pinned V3 exception.
+  if peer is None and spec.sha256 != V3_SPEC.sha256:
+    return spec
+  # The daemon includes its selected transport in the local handshake. This
+  # keeps App selection scoped to the existing recognized protocol3 paths.
+  if isinstance(peer, dict) and peer.get('protocol') == 3 and may_provision(peer, mode):
+    return spec
+  expected = jetson_spec(peer, mode) or DEFAULT_SPEC
+  if spec.to_dict() != expected.to_dict():
+    raise ValueError('Jetlink selected model identity or input/output contract mismatch')
+  return spec
+
